alert icmp any any -> any any (msg:"LOCAL ICMP echo request"; itype:8; classtype:misc-activity; sid:1000001; rev:1;)
alert http any any -> any any (msg:"LOCAL HTTP IDS test URI"; flow:established,to_server; http.uri; content:"/ids-test"; startswith; classtype:web-application-activity; sid:1000002; rev:1;)
alert tcp any any -> any any (msg:"LOCAL Possible TCP SYN scan or burst"; flags:S; flow:stateless; detection_filter:track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000003; rev:1;)